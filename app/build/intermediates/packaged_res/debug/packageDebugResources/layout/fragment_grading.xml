<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GRADING TOOL"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp"/>

        <!-- Color Guide -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colour Check"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <LinearLayout
                        android:id="@+id/card_golden"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_color_golden"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🌕" android:textSize="22sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Golden" android:textSize="11sp" android:textColor="#7A4800"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_amber"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_color_amber"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🟠" android:textSize="22sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Amber" android:textSize="11sp" android:textColor="#7A3800"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_dark"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_color_dark"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🟤" android:textSize="22sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dark" android:textSize="11sp" android:textColor="#3D2000"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Moisture Test -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Moisture Test"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tv_moisture_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/honey"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_moisture_fill"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="20"
                    android:progress="7"
                    android:progressTint="@color/forest"
                    android:layout_marginBottom="14dp"/>

                <SeekBar
                    android:id="@+id/seek_moisture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:progressTint="@color/forest"
                    android:thumbTint="@color/forest"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adjust slider to your refractometer reading"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_grade_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Grade A — Retail Ready ✓"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/forest"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_grade_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excellent! Moisture below 18% means low fermentation risk."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Grading Key -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Grading Key" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="10dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⭐ Grade A  — Moisture &lt; 18%  — Retail Ready" android:textSize="13sp"
                    android:textColor="@color/forest" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔶 Grade B  — Moisture 18–20%  — Filter First" android:textSize="13sp"
                    android:textColor="@color/honey" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚠ Grade C  — Moisture &gt; 20%  — High Risk" android:textSize="13sp"
                    android:textColor="@color/red_dark"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
